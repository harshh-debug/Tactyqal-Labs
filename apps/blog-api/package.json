{
  "name": "@tactyqal/blog-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --experimental-transform-types --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "db:migrate": "node --env-file-if-exists=.env --experimental-transform-types src/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --experimental-transform-types src/seed.ts",
    "test:integration": "node --env-file-if-exists=.env.test --experimental-transform-types --test-isolation=none --test test/*.test.ts"
  },
  "dependencies": {
    "@tactyqal/contracts": "workspace:*",
    "bcryptjs": "3.0.2",
    "express": "5.2.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1"
  }
}
